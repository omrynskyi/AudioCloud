# Rust
target/
src-tauri/target/

# Node (build-time only -- see overview.md §1)
node_modules/
dist/
dist-ssr/
*.local

# Tauri generated
src-tauri/gen/

# Models are release assets, never repo artifacts (Phase 3)
*.onnx
*.onnx.partial

# Build products
*.dmg
*.app/

# Local app data, if it is ever symlinked into the tree for debugging
/appdata
/Application Support

# Data layer artifacts (Phase 1). The real ones live in
# ~/Library/Application Support/<bundle-id>/; these patterns exist so a copy pulled into
# the tree for debugging cannot be committed by accident. Every byte of them is derived
# from the user's own files.
*.db
*.db-wal
*.db-shm
embeddings.bin
embeddings.bin.compacting

# macOS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Logs
*.log
npm-debug.log*
